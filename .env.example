# Porta HTTP do serviço.
PORT=3001

# Origem permitida no CORS. Só importa para chamadas diretas do browser — o
# Orbita consome via proxy server-side (src/app/api/prospectar/*), então CORS
# não se aplica no caminho de produção.
ALLOWED_ORIGIN=http://localhost:3000

# Caminho do binário do Chrome/Chromium. Deixe vazio para auto-detectar.
# Na imagem Docker já vem apontado para o headless-shell.
# Local no macOS:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Quantos scrapes rodam em paralelo. Default 1 (serializado). O Bing degrada os
# resultados sob buscas concorrentes do mesmo IP — só suba isto com rotação de
# IP/proxy. Ver docs/ARCHITECTURE.md (Notas de operação).
SCRAPE_CONCURRENCY=1

# Conexão com o Mongo (mesmo cluster do Orbita). Habilita o POST /scrape
# assíncrono; sem isto, só o GET /scrape (SSE) funciona. As coleções escritas
# são scrapesessions e scrapeleads, as mesmas que o Orbita lê.
MONGODB_URI=mongodb+srv://user:pass@host/orbita
# Banco a usar (default: orbita).
MONGODB_DB=orbita

# Tempo máximo de um job assíncrono, em minutos (default: 30).
# JOB_TIMEOUT_MINUTES=30

# Geocoder usado nos jobs por área (campo "location"). O Nominatim público
# exige um User-Agent identificável e no máximo 1 requisição/segundo.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_USER_AGENT=orbita-prospectar/1.0 (+https://axolutions.com.br)

# Nível de log (sintaxe do tracing-subscriber). "debug" mostra falhas de
# avaliação JS na página.
# RUST_LOG=info

# Logs de diagnóstico da paginação (qualquer valor não-vazio liga).
# SCRAPER_DEBUG=1
